# Server-side only. Never expose or commit real values.
HOUSE_SUPABASE_URL=https://project-demo.supabase.co
HOUSE_SUPABASE_SERVICE_ROLE_KEY=replace-with-server-side-secret

# Use a short-lived token for an interactive run:
HOUSE_GOOGLE_ACCESS_TOKEN=replace-with-short-lived-token

# Or use all three values for unattended refresh:
# HOUSE_GOOGLE_CLIENT_ID=replace-with-oauth-client-id
# HOUSE_GOOGLE_CLIENT_SECRET=replace-with-oauth-client-secret
# HOUSE_GOOGLE_REFRESH_TOKEN=replace-with-oauth-refresh-token

# Experimental server-side Skylight visibility bridge. Use only a short-lived,
# revocable bearer token; never place a Skylight account password here.
# HOUSE_SKYLIGHT_ACCESS_TOKEN=replace-with-short-lived-token
